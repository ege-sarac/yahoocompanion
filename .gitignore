# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build and test output
dist/
coverage/
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Local scratch data
data/raw/*
!data/raw/.gitkeep

# Processed JSON is the versioned offline data bundle used by the local app.
# Keep raw source downloads out of Git, but ship processed files so a clone can run.
